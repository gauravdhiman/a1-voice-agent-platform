# Cloud STAGING environment — oc-dev-ai-voice-agent-platform
#
# Copy to .env.staging at the repo root and fill in secrets from Supabase dashboard:
#   Project: https://supabase.com/dashboard/project/gdzwiwukcwbqohfwxxrx
#   Settings → API Keys → Secret keys (replaces legacy "service_role")
#   Project top bar → Connect → Session pooler URI (for Alembic DATABASE_URL)
#
# Use for local Docker against staging (not production):
#   cp .env.staging .env
#   ./start.sh restart dev
#
# Bootstrap staging DB (first time): ./scripts/bootstrap-staging-db.sh
#
# See docs/05_operations/staging_environment.md

# Supabase (staging — gdzwiwukcwbqohfwxxrx)
SUPABASE_URL=https://gdzwiwukcwbqohfwxxrx.supabase.co
SUPABASE_SERVICE_KEY=your-staging-secret-key-here
SUPABASE_ANON_KEY=your-staging-publishable-or-legacy-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://gdzwiwukcwbqohfwxxrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-publishable-or-legacy-anon-key-here

# Shared by backend + voice-ws (generate: openssl rand -base64 64)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Resend (can match production for now; split later)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=team@247ai.live
RESEND_FROM_NAME=24x7 AI

# Application (local Docker → staging DB)
APP_NAME=24x7 AI
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=staging
DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000", "http://frontend-dev:3000"]

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=24x7 AI
NEXT_PUBLIC_APP_DESCRIPTION=24x7 AI voice agent platform (staging)

# Alembic — URL-encode special characters in the database password
DATABASE_URL=postgresql://postgres.gdzwiwukcwbqohfwxxrx:your-url-encoded-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Stripe (shared with production for now; use test keys when split)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# OpenTelemetry (optional for local staging validation)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=24x7-ai-backend-staging
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live
NEXT_PUBLIC_OTEL_ENABLED=false

# Google OAuth for tools (shared with production for now)
GOOGLE_OAUTH_TOOL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_TOOL_REDIRECT_URI=http://localhost:8000/api/v1/tools/callback

# Voice (local voice-ws against staging backend)
VOICE_TRANSPORT=pipecat
VOICE_WS_PUBLIC_URL=ws://localhost:8765
GEMINI_API_KEY=your-gemini-api-key

TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5
TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15
