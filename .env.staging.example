# 24x7 AI — STAGING environment template
#
# Copy to .env.staging at the repo root and fill in secrets from the staging
# Supabase dashboard:
#   Project: https://supabase.com/dashboard/project/gdzwiwukcwbqohfwxxrx
#   Settings → API Keys → Secret keys (replaces legacy "service_role")
#   Project top bar → Connect → Session pooler URI (for Alembic DATABASE_URL)
#
# Use for local Docker against staging (not production):
#   ./start.sh start dev --env staging
#   ./start.sh config --env staging
#
# Bootstrap staging DB (first time): ./scripts/bootstrap-staging-db.sh
#
# See docs/05_operations/staging_environment.md

# Supabase — staging project gdzwiwukcwbqohfwxxrx
SUPABASE_URL=https://gdzwiwukcwbqohfwxxrx.supabase.co
SUPABASE_SERVICE_KEY=your-staging-secret-key-here
SUPABASE_ANON_KEY=your-staging-publishable-or-legacy-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://gdzwiwukcwbqohfwxxrx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-publishable-or-legacy-anon-key-here

# Shared by backend + voice-ws (generate: openssl rand -base64 64)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ENCRYPTION_KEY=your-fernet-encryption-key

# Resend (can match production for now; split later)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=team@247ai.live
RESEND_FROM_NAME=24x7 AI
PHONE_NUMBER_BILLING_CHECK_INTERVAL_HOURS=24
PHONE_NUMBER_BILLING_GRACE_PERIOD_DAYS=7
PHONE_NUMBER_RELEASE_RETRY_INTERVAL_HOURS=24
NOTIFICATION_RETRY_CHECK_INTERVAL_HOURS=1
NOTIFICATION_RETRY_CHECK_INTERVAL_MINUTES=5

# Application (local Docker → staging DB)
APP_NAME=24x7 AI
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=staging
DEBUG=true
# Docker host ports for local staging validation. Set PORT_OFFSET per worktree
# to shift the complete host-port set without editing Compose files.
PORT_OFFSET=0

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000", "http://frontend-dev:3000"]

API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=24x7 AI
NEXT_PUBLIC_APP_DESCRIPTION=24x7 AI voice agent platform (staging)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google and LinkedIn sign-in providers (same application credentials for now)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-web-client-secret
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=your-linkedin-client-id
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_OAUTH_SCOPES=openid profile email

# Alembic — URL-encode special characters in the database password
DATABASE_URL=postgresql://postgres.gdzwiwukcwbqohfwxxrx:your-url-encoded-password@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# Stripe (shared with production for now; use test keys when split)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# OpenTelemetry (optional for local staging validation)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=24x7-ai-backend-staging
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_SERVICE_NAME=24x7-ai-frontend-staging
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
NEXT_OTEL_VERBOSE=0
NEXT_OTEL_FETCH_DISABLED=1

# Optional New Relic integration
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME=24x7 AI

# Google OAuth for tools (shared with production for now)
GOOGLE_OAUTH_TOOL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_TOOL_REDIRECT_URI=http://localhost:8000/api/v1/tools/callback

# Voice (local voice-ws against staging backend)
VOICE_TRANSPORT=pipecat
VOICE_WS_PUBLIC_URL=ws://localhost:7860
VOICE_WS_TWILIO_URL=
VOICE_RECORDING_TEE=false
VOICE_RECORDING_ENABLED=false
RECORDING_STORAGE_BACKEND=r2
RECORDING_STORAGE_LOCAL_ROOT=.local-data/call-recordings
RECORDING_ENCRYPTION_MODE=provider_managed
RECORDING_RETENTION_DAYS=90
# One Cloudflare account; use the staging bucket for this environment.
RECORDING_R2_ENDPOINT=https://e168c1bca6abb23e49bae87a6a8ea38b.r2.cloudflarestorage.com
RECORDING_R2_BUCKET=247ai-call-recordings-staging
RECORDING_R2_ACCESS_KEY_ID=your-staging-bucket-scoped-r2-access-key
RECORDING_R2_SECRET_ACCESS_KEY=your-staging-bucket-scoped-r2-secret-key
RECORDING_R2_PRESIGN_TTL_SECONDS=300
LIVEKIT_URL=your-livekit-url
NEXT_PUBLIC_LIVEKIT_URL=your-livekit-url
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_SIP_DOMAIN=your-livekit-sip-domain
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
FISH_API_KEY=your-fish-audio-api-key
AGENT_DEFAULT_TIMEZONE=America/Phoenix

TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5
TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15

# Twilio and MCP security
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER_SID=your-twilio-phone-number-sid
TWILIO_WEBHOOK_SIGNATURE_VALIDATION_ENABLED=true
MCP_ALLOW_LOCAL_URLS=true

# Generic MCP OAuth (optional; server-specific OAuth metadata is preferred).
# Leave the client fields empty when the MCP supports dynamic client registration.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/tools/callback
# MCP_OAUTH_STATE_SECRET=  # Optional; falls back to JWT_SECRET_KEY.
