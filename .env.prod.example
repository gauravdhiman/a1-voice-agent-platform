# Production cloud deployment environment (247ai.live)
#
# Canonical non-secret deployment configuration lives in
# deploy/config/production.env. This complete template is retained as a
# compatibility reference for manually generated .env.prod files only.
#
# Supabase production project: zymiyfilulmtrmyyhvzw
# For STAGING (local validation), use .env.staging.example → .env.staging instead.
# See docs/05_operations/staging_environment.md
# .env.prod is gitignored — never commit credentials.
#
# Used by: ./scripts/deploy.sh
# See also: docs/05_operations/deployment/runbook.md and docs/ENV_VARS.md

# Supabase (cloud project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cloud release configuration. Non-secret values are maintained in the
# version-controlled deploy/config/production.env file. Secret values live in
# GCP Secret Manager (Cloud Run/backend) and OCI Vault (voice-ws/Oracle VM).
SECRET_MANAGER_MODE=gcp
GCP_SECRET_MANAGER_PROJECT_ID=your-gcp-project-id
GCP_SECRET_NAME_PREFIX=247ai-production
GCP_BACKEND_RUNTIME_SERVICE_ACCOUNT=247ai-backend-runtime@your-gcp-project-id.iam.gserviceaccount.com
OCI_VAULT_ID=ocid1.vault.oc1..your-vault-ocid
OCI_SECRET_NAME_PREFIX=247ai-production

# JWT secret shared by backend + voice-ws (generate: openssl rand -base64 64)
JWT_SECRET_KEY=change-me-to-a-long-random-secret
ENCRYPTION_KEY=your-fernet-encryption-key
# Optional comma-separated previous Fernet keys during controlled key rotation.
ENCRYPTION_KEY_FALLBACKS=

# Controlled-SaaS signup gate (Epic A). False = invite-only; invitations and
# allowlisted admins can still sign up. True reopens open self-serve.
PUBLIC_SIGNUP_ENABLED=false
# Comma-separated emails that always pass the signup gate (platform admins).
PLATFORM_ADMIN_ALLOWLIST=

# Resend (transactional email)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=team@notify.247ai.live
RESEND_FROM_NAME=24x7 AI
PHONE_NUMBER_BILLING_CHECK_INTERVAL_HOURS=24
PHONE_NUMBER_BILLING_GRACE_PERIOD_DAYS=7
PHONE_NUMBER_RELEASE_RETRY_INTERVAL_HOURS=24
NOTIFICATION_RETRY_CHECK_INTERVAL_HOURS=1
NOTIFICATION_RETRY_CHECK_INTERVAL_MINUTES=5

# Application (production URLs — 247ai.live)
APP_NAME=24x7 AI
APP_BASE_URL=https://www.247ai.live
ENVIRONMENT=production
DEBUG=false
# Docker host ports when running the production Compose file locally. Set
# PORT_OFFSET per worktree to shift all local service ports together.
PORT_OFFSET=0
API_BASE_URL=https://api.247ai.live

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["https://www.247ai.live"]

# Frontend (baked into Next.js at Docker build time)
NEXT_PUBLIC_API_URL=https://api.247ai.live
NEXT_PUBLIC_APP_NAME=24x7 AI
NEXT_PUBLIC_APP_DESCRIPTION=Your app tagline here.
NEXT_PUBLIC_LAUNCH_FILM_MEDIA_BASE_URL=
# Product analytics (PostHog Cloud). Empty = analytics disabled.
# Set the project token before building the frontend image for production.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Bot protection (Cloudflare Turnstile). Production must set both.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Google and LinkedIn sign-in providers (same application credentials for now)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-web-client-secret

# Direct LinkedIn OIDC sign-in (registered as custom:linkedin in Supabase)
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=your-linkedin-client-id
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_OAUTH_SCOPES=openid profile email

# Database migrations (Alembic) — URL-encode special chars in password
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe
# Set test explicitly for the temporary soft-production deployment. The
# managed production release defaults to live mode when this is omitted.
STRIPE_MODE=live
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_stripe_publishable_key

# Production-only cloud telemetry. Keep disabled until the authenticated
# collector endpoint and headers have been provisioned. Staging/local examples
# intentionally remain disabled and never use the production cloud accounts.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=247ai-backend
OTEL_BACKEND_SERVICE_NAME=247ai-backend
OTEL_VOICE_WS_SERVICE_NAME=247ai-voice-ws
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live
OTEL_SERVICE_VERSION=release-sha
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://telemetry.yourdomain.com/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic replace-with-otlp-basic-auth
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://telemetry.yourdomain.com/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_HEADERS=Authorization=Basic replace-with-otlp-basic-auth
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://telemetry.yourdomain.com/v1/logs
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_HEADERS=Authorization=Basic replace-with-otlp-basic-auth
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_SERVICE_NAME=247ai-frontend
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://your-otel-endpoint/v1/traces
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://your-otel-endpoint/v1/metrics
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://your-otel-endpoint/v1/logs
NEXT_OTEL_VERBOSE=0
NEXT_OTEL_FETCH_DISABLED=1

# Google OAuth (tool connections — Calendar, Gmail, etc.)
GOOGLE_OAUTH_TOOL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_TOOL_REDIRECT_URI=https://api.yourdomain.com/api/v1/tools/callback

# Voice transport (production uses Pipecat WebSocket worker on OCI)
VOICE_TRANSPORT=pipecat
VOICE_WS_PUBLIC_URL=wss://voice.yourdomain.com
VOICE_WS_TWILIO_URL=wss://voice.yourdomain.com
VOICE_WS_WORKERS=1
MCP_HOST=127.0.0.1
MCP_PORT=8733
VOICE_RECORDING_TEE=false
VOICE_RECORDING_ENABLED=true
RECORDING_STORAGE_BACKEND=r2
RECORDING_STORAGE_LOCAL_ROOT=.local-data/call-recordings
RECORDING_ENCRYPTION_MODE=provider_managed
RECORDING_RETENTION_DAYS=90
# One Cloudflare account; use the production bucket with bucket-scoped keys.
RECORDING_R2_ENDPOINT=https://e168c1bca6abb23e49bae87a6a8ea38b.r2.cloudflarestorage.com
RECORDING_R2_BUCKET=247ai-call-recordings-production
RECORDING_R2_ACCESS_KEY_ID=your-production-bucket-scoped-r2-access-key
RECORDING_R2_SECRET_ACCESS_KEY=your-production-bucket-scoped-r2-secret-key
RECORDING_R2_PRESIGN_TTL_SECONDS=300
# AI / voice provider fallbacks (voice-ws + pipeline presets)
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
FISH_API_KEY=your-fish-audio-api-key

# Agent prompt timezone fallback
AGENT_DEFAULT_TIMEZONE=America/Phoenix

# OAuth token refresh (backend background job)
TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5
TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15
TOKEN_REFRESH_ATTENTION_WINDOW_MINUTES=30
TOKEN_REFRESH_LOCK_LEASE_SECONDS=180

# Twilio (PSTN / SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER_SID=your-default-twilio-phone-number-sid
TWILIO_SMS_FROM_NUMBER=+15551234567
TWILIO_WHATSAPP_FROM_NUMBER=+15551234567
TWILIO_WHATSAPP_CONTENT_SID=HXXXXXXXXX00000000000000000000000000
TWILIO_WEBHOOK_SIGNATURE_VALIDATION_ENABLED=true

# MCP SSRF guard — keep false in production
MCP_ALLOW_LOCAL_URLS=false

# Generic MCP OAuth (optional; server-specific OAuth metadata is preferred).
# Leave the client fields empty when the MCP supports dynamic client registration.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=https://api.yourdomain.com/api/v1/tools/callback
# MCP_OAUTH_STATE_SECRET=  # Optional; falls back to JWT_SECRET_KEY.

# OCI voice-ws SSH (set in shell when deploying voice-ws — not in this file):
#   export OCI_SSH_HOST=<vm-public-ip>
#   export OCI_SSH_USER=ubuntu
#   export OCI_SSH_KEY=~/.ssh/oci_voice_ws

# Explicit policy; production never infers verification from sender fields.
EMAIL_VERIFICATION_REQUIRED=true

# Shared Redis rate-limit storage. Required before scaling deployed backend instances.
# Store authenticated Redis URLs only in managed secrets.
REDIS_URL=
