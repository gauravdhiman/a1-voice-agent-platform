# Minimal production cloud profile. Copy to .env.observability (ignored by Git).
# The cloud Compose profile runs only Caddy and the OpenTelemetry Collector;
# Grafana Cloud and Langfuse Cloud provide storage, dashboards and alerting.
COLLECTOR_CONFIG_FILE=./deploy/observability/collector.cloud.yml
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
# Grafana Cloud: Basic base64(<stack-instance-id>:<cloud-access-policy-token>).
GRAFANA_CLOUD_OTLP_AUTH='Basic replace-with-grafana-cloud-basic-auth'
LANGFUSE_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel
# Langfuse: Basic base64(<public-key>:<secret-key>).
LANGFUSE_OTLP_AUTH='Basic replace-with-langfuse-basic-auth'

# Collector ingress. Generate the bcrypt hash interactively with Caddy.
OBSERVABILITY_DOMAIN=telemetry.example.com
OTLP_USERNAME=platform-telemetry
# Single quotes preserve $ signs in bcrypt hashes.
OTLP_PASSWORD_HASH='replace-with-bcrypt-hash'
HOST_OTEL_HEALTH_PORT=13133

# The following values are only for the optional fully self-hosted local stack
# (docker-compose.observability.yml). They are not used by the cloud profile.
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-unique-password
HOST_GRAFANA_PORT=3300
HOST_PROMETHEUS_PORT=9090
HOST_ALERTMANAGER_PORT=9093
OBSERVABILITY_PROBE_TARGETS=/absolute/private/path/readiness-targets.json
ALERTMANAGER_CONFIG_FILE=/absolute/private/path/alertmanager.yml
