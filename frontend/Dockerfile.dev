# Development Dockerfile for hot reloading
FROM node:20-alpine

WORKDIR /app

# Install dependencies (seed for anonymous volume; refreshed at runtime)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3000

# Ensure dependencies stay in sync with package.json changes.
# The anonymous volume for /app/node_modules persists across rebuilds,
# so without this, new deps (e.g. mermaid) added to package.json would be
# missing at runtime, causing "Cannot find module 'mermaid'" errors.
# The entrypoint installs dependencies only when package metadata changes and
# keeps the anonymous .next volume intact so restarts do not discard the local
# development cache.
COPY docker-entrypoint.dev.sh /usr/local/bin/frontend-dev-entrypoint
RUN chmod +x /usr/local/bin/frontend-dev-entrypoint

CMD ["/usr/local/bin/frontend-dev-entrypoint"]
