# Backend compatibility environment template
#
# The supported workflow uses the root .env.local/.env.staging/.env.prod files.
# Use ENV_FILE=.env.staging (or another canonical file) for direct commands.
# Do not copy this file into a root .env.

# Application Settings
APP_NAME=24x7 AI
APP_BASE_URL=http://localhost:3000
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000
RELOAD=true

# CORS Settings (JSON array format)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000"]
CORS_CREDENTIALS=true

# Database Settings (Supabase integration)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Database Migration Settings (Alembic)
# Note: For migrations, use the postgres user with database password. Use unicode characters for special characters like @, #, etc, eg. for # use %23
# Format: postgresql://postgres:[PASSWORD]@[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-database-password-here@your-project-ref.supabase.co:5432/postgres

# Redis Settings (Future integration)
# REDIS_URL=

# JWT Settings — required for authentication
# JWT_SECRET_KEY must match your Supabase JWT secret (Dashboard → Settings → API → JWT Secret)
JWT_SECRET_KEY=your-supabase-jwt-secret-here
# Optional website-to-business-context providers (backend only).
TINYFISH_API_KEY=your-tinyfish-api-key
GEMINI_API_KEY=your-gemini-api-key
# Fernet key for OAuth/API credentials at rest (generate with ``Fernet.generate_key()``).
ENCRYPTION_KEY=your-fernet-encryption-key
# Optional comma-separated previous Fernet keys during controlled key rotation.
ENCRYPTION_KEY_FALLBACKS=
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30

# Direct LinkedIn OIDC sign-in (same credentials as Supabase linkedin_oidc)
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=your-linkedin-client-id
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_OAUTH_SCOPES=openid profile email

# Stripe Settings
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_MODE=test
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Resend Settings
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=team@notify.247ai.live
RESEND_FROM_NAME=24x7 AI

# New Relic Configuration for OpenTelemetry
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-here

# OpenTelemetry Configuration
OTEL_ENABLED=true
OTEL_SERVICE_NAME=saas-platform-backend
# Traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_TRACES_INSECURE=true
# Metrics
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_METRICS_INSECURE=true
# Logs
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_LOGS_INSECURE=true

# OpenTelemetry Configuration - FastAPI Instrumentation
# Exclude health check endpoints from tracing to reduce noise
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live

# Google OAuth Configuration for Tools (for Google Calendar, Gmail, etc.)
# This is a redirect URI for tool OAuth flows, not for main application OAuth
GOOGLE_OAUTH_TOOL_CLIENT_ID=
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=
GOOGLE_OAUTH_TOOL_REDIRECT_URI=

# Generic MCP OAuth (optional; server-specific OAuth metadata is preferred).
# Leave the client fields empty when the MCP supports dynamic client registration.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=
# MCP_OAUTH_STATE_SECRET=  # Optional; falls back to JWT_SECRET_KEY.

# Token Refresh Service Configuration
# Interval in minutes to check for tokens needing refresh (default: 5)
# TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5

# Window in minutes before expiry to refresh tokens (default: 15)
# TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15
# TOKEN_REFRESH_ATTENTION_WINDOW_MINUTES=30
