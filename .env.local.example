# 24x7 AI — LOCAL environment template
#
# Canonical non-secret local configuration lives in deploy/config/local.env.
# This complete template remains the local runtime compatibility file; put
# credentials only in the ignored copy.
#
# Copy once to .env.local. Do not copy this file into .env; .env is not used
# by the supported startup flow.
#
# Start local Docker services:
#   ./start.sh start dev
# Inspect the selected file safely:
#   ./start.sh config --env local

# -----------------------------------------------------------------------------
# Supabase — local containers
# -----------------------------------------------------------------------------
# Docker services use host.docker.internal; the browser uses 127.0.0.1.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_KEY=your-local-service-role-key
SUPABASE_ANON_KEY=your-local-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Secret-manager selection. Local services use the env file; cloud release
# config files set SECRET_MANAGER_MODE=gcp and keep secret values out of GitHub.
SECRET_MANAGER_MODE=env
GCP_SECRET_MANAGER_PROJECT_ID=
GCP_SECRET_NAME_PREFIX=
GCP_BACKEND_RUNTIME_SERVICE_ACCOUNT=
OCI_VAULT_ID=
OCI_SECRET_NAME_PREFIX=

# Local database connection used by Alembic from Docker.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres

# -----------------------------------------------------------------------------
# Application, backend, and frontend
# -----------------------------------------------------------------------------
APP_NAME=24x7 AI
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=development
DEBUG=true
# Docker host ports. Set PORT_OFFSET per worktree (for example, 20) to shift
# frontend, backend, voice-ws, and OTEL ports together. HOST_* values can
# explicitly override individual ports when a non-uniform map is required.
PORT_OFFSET=0
API_BASE_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://frontend:3000", "http://frontend-dev:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=24x7 AI
# Product analytics (PostHog Cloud). Empty = analytics disabled.
# Use a separate project key for local development to keep production data clean.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Bot protection (Cloudflare Turnstile). Empty secret/site key = verification
# disabled (local/dev). Production must set both.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_APP_DESCRIPTION=Your AI front desk. Always on. 24x7 AI answers every call, books appointments, and follows up with your customers.

# -----------------------------------------------------------------------------
# Secrets and authentication
# -----------------------------------------------------------------------------
# Keep these stable for the environment. ENCRYPTION_KEY protects secrets stored
# in the database; JWT_SECRET_KEY is shared by backend and voice-ws.
ENCRYPTION_KEY=your-fernet-encryption-key
# Optional comma-separated previous Fernet keys during controlled key rotation.
ENCRYPTION_KEY_FALLBACKS=
JWT_SECRET_KEY=your-local-jwt-secret

# Controlled-SaaS signup gate (Epic A). False = invite-only; invitations and
# allowlisted admins can still sign up. True reopens open self-serve.
PUBLIC_SIGNUP_ENABLED=false
# Comma-separated emails that always pass the signup gate (platform admins).
PLATFORM_ADMIN_ALLOWLIST=

# Google and LinkedIn sign-in providers (same application credentials for now).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-web-client-secret
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=your-linkedin-client-id
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_OAUTH_SCOPES=openid profile email

# Google tool connections (Calendar, Gmail, and other OAuth tools).
GOOGLE_OAUTH_TOOL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_TOOL_REDIRECT_URI=http://localhost:8000/api/v1/tools/callback

# Transactional email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=team@247ai.live
RESEND_FROM_NAME=24x7 AI
PHONE_NUMBER_BILLING_CHECK_INTERVAL_HOURS=24
PHONE_NUMBER_BILLING_GRACE_PERIOD_DAYS=7
PHONE_NUMBER_RELEASE_RETRY_INTERVAL_HOURS=24
NOTIFICATION_RETRY_CHECK_INTERVAL_HOURS=1
NOTIFICATION_RETRY_CHECK_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# Billing and observability
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_MODE=test
# Disabled for the regular local profile. The isolated worktree launcher opts
# into its private local collector when you need to inspect a test call.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=24x7-ai-backend-local
OTEL_BACKEND_SERVICE_NAME=24x7-ai-backend-local
OTEL_VOICE_WS_SERVICE_NAME=24x7-ai-voice-ws-local
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live
OTEL_SERVICE_VERSION=development
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_EXPORTER_OTLP_LOGS_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_LOGS_HEADERS=
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_SERVICE_NAME=24x7-ai-frontend-local
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
NEXT_OTEL_VERBOSE=0
NEXT_OTEL_FETCH_DISABLED=1

# -----------------------------------------------------------------------------
# Voice, AI providers, and integrations
# -----------------------------------------------------------------------------
VOICE_TRANSPORT=pipecat
VOICE_WS_PUBLIC_URL=ws://localhost:7860
VOICE_WS_TWILIO_URL=
VOICE_WS_WORKERS=1
MCP_HOST=127.0.0.1
MCP_PORT=8733
VOICE_RECORDING_TEE=false
VOICE_RECORDING_ENABLED=false
RECORDING_STORAGE_BACKEND=local
RECORDING_STORAGE_LOCAL_ROOT=.local-data/call-recordings
RECORDING_ENCRYPTION_MODE=provider_managed
RECORDING_RETENTION_DAYS=90
RECORDING_R2_ENDPOINT=
RECORDING_R2_BUCKET=
RECORDING_R2_ACCESS_KEY_ID=
RECORDING_R2_SECRET_ACCESS_KEY=
RECORDING_R2_PRESIGN_TTL_SECONDS=300
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
FISH_API_KEY=your-fish-audio-api-key
AGENT_DEFAULT_TIMEZONE=America/Phoenix

# OAuth refresh, telephony, and MCP security.
TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5
TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15
TOKEN_REFRESH_ATTENTION_WINDOW_MINUTES=30
TOKEN_REFRESH_LOCK_LEASE_SECONDS=180
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER_SID=your-twilio-phone-number-sid
TWILIO_SMS_FROM_NUMBER=+15551234567
TWILIO_WEBHOOK_SIGNATURE_VALIDATION_ENABLED=true
# Allows local MCP servers and local OAuth callbacks in development.
MCP_ALLOW_LOCAL_URLS=true

# Generic MCP OAuth (optional; server-specific OAuth metadata is preferred).
# Leave the client fields empty when the MCP supports dynamic client registration.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/tools/callback
# MCP_OAUTH_STATE_SECRET=  # Optional; falls back to JWT_SECRET_KEY.
