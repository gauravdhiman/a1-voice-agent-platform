# Production cloud deployment environment (247ai.live)
#
# Supabase production project: zymiyfilulmtrmyyhvzw
# For STAGING (local validation), use .env.staging.example → .env.staging instead.
# See docs/05_operations/staging_environment.md
# .env.cloud is gitignored — never commit credentials.
#
# Used by: ./scripts/deploy.sh
# See also: docs/05_operations/DEPLOYMENT.md, docs/ENV_VARS.md

# Supabase (cloud project)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# JWT secret shared by backend + voice-ws (generate: openssl rand -base64 64)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=team@247ai.live
RESEND_FROM_NAME=24x7 AI
NEXT_PUBLIC_APP_NAME=24x7 AI
NEW_RELIC_APP_NAME=24x7 AI

# Application (production URLs — 247ai.live)
APP_NAME=24x7 AI
APP_BASE_URL=https://www.247ai.live
ENVIRONMENT=production
DEBUG=false

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["https://www.247ai.live"]

# Frontend (baked into Next.js at Docker build time)
NEXT_PUBLIC_API_URL=https://api.247ai.live
NEXT_PUBLIC_APP_NAME=24x7 AI
NEXT_PUBLIC_APP_DESCRIPTION=Your app tagline here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Direct LinkedIn OIDC sign-in (registered as custom:linkedin in Supabase)
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=your-linkedin-client-id
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_OAUTH_SCOPES=openid profile email

# Database migrations (Alembic) — URL-encode special chars in password
DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_your_stripe_publishable_key

# OpenTelemetry (disabled for initial cloud deploy)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=your-app-backend
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=/health,/health/ready,/health/live
NEXT_PUBLIC_OTEL_ENABLED=false
NEXT_PUBLIC_OTEL_SERVICE_NAME=your-app-frontend
NEXT_OTEL_VERBOSE=0
NEXT_OTEL_FETCH_DISABLED=1

# Optional: New Relic (if OTEL collector is enabled later)
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-here
NEW_RELIC_APP_NAME=Your App Name

# Google OAuth (tool connections — Calendar, Gmail, etc.)
GOOGLE_OAUTH_TOOL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_TOOL_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_TOOL_REDIRECT_URI=https://api.yourdomain.com/api/v1/tools/callback

# Voice transport (production uses Pipecat WebSocket worker on OCI)
VOICE_TRANSPORT=pipecat
VOICE_WS_PUBLIC_URL=wss://voice.yourdomain.com
VOICE_WS_TWILIO_URL=wss://voice.yourdomain.com
VOICE_RECORDING_TEE=false

# AI / voice provider fallbacks (voice-ws + pipeline presets)
GEMINI_API_KEY=your-gemini-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
FISH_API_KEY=your-fish-audio-api-key

# Agent prompt timezone fallback
AGENT_DEFAULT_TIMEZONE=America/Phoenix

# OAuth token refresh (backend background job)
TOKEN_REFRESH_CHECK_INTERVAL_MINUTES=5
TOKEN_REFRESH_EXPIRY_WINDOW_MINUTES=15

# Twilio (PSTN / SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER_SID=your-default-twilio-phone-number-sid

# MCP SSRF guard — keep false in production
MCP_ALLOW_LOCAL_URLS=false

# OCI voice-ws SSH (set in shell when deploying voice-ws — not in this file):
#   export OCI_SSH_HOST=<vm-public-ip>
#   export OCI_SSH_USER=ubuntu
#   export OCI_SSH_KEY=~/.ssh/oci_voice_ws
