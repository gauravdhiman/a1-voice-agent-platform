**/.env.*
**/.env*
**/.env.*.local
**/.env*.bak
**/.env*.backup
**/.git
**/.gitignore
**/.worktrees
.local-data
graphify-out
.agents
.codex
node_modules
frontend/.next
frontend/node_modules
**/__pycache__
**/.pytest_cache
